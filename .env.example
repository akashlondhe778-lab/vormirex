# Supabase project connection (safe to expose to the browser — the anon key is
# subject to Row Level Security, it is NOT a secret).
# Find these in Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ---------------------------------------------------------------------------
# The variables below are SERVER-ONLY. They must never be prefixed with
# VITE_ (which Vite inlines into client bundles) and must never be read from
# frontend code. They belong in Supabase Edge Function secrets
# (`supabase secrets set ...`), not in this file's real values, and never in
# the frontend runtime. Documented here only so the requirement is explicit.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=          # Edge Functions only. Full DB bypass — never ship to the browser.
# PAYMENT_GATEWAY_KEY_ID=             # e.g. Razorpay key id, used server-side in the create-order Edge Function
# PAYMENT_GATEWAY_KEY_SECRET=         # e.g. Razorpay key secret, used server-side to verify payment signatures

# ---------------------------------------------------------------------------
# Legacy (unused): originally scaffolded from an AI Studio template. No code
# in this repo currently calls the Gemini API — kept only so existing local
# setups don't break. Safe to remove once the AI Tutor feature is wired to a
# real backend (out of scope for the Supabase backend integration).
# ---------------------------------------------------------------------------
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
